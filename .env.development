# The dev branch is deployed and tested against the isolated Rocky test API.
# Production builds continue to use same-origin nginx routing from
# .env.production and are unaffected by these development-only values.
VITE_PROXY_API_URL=https://api.rockytest.xyz
VITE_PROXY_SPOT_URL=https://api.rockytest.xyz
VITE_PROXY_WS_URL=wss://api.rockytest.xyz
